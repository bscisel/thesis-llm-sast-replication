# Konfiguracja potrzebna wyłącznie do powtórzenia przebiegu modeli.
# Do przeliczenia wyników z zapisanych danych nie jest potrzebna.
# Skopiuj do .env i uzupełnij.

# --- klucze API ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- nazwy modeli u dostawców ---
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL_SMALL=openai/gpt-oss-20b

# Endpoint przypięty na sztywno: bez tego router mógłby obsłużyć kolejne powtórzenia
# tego samego ostrzeżenia wagami o innej kwantyzacji, co psuje pomiar stabilności (H3).
OPENROUTER_PROVIDER=deepinfra/bf16
OPENROUTER_PROVIDER_SMALL=deepinfra/bf16
OPENROUTER_CACHE_CONTROL=0

# --- model lokalny (Qwen3.5 9B przez Ollamę) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# --- kontekst kodu ---
# Katalog ze źródłami analizowanego projektu; potrzebny do wycinków kodu w prompcie
# oraz do miary osadzenia uzasadnień (H4, tabela 7.5).
SOURCE_ROOT=

LLM_NUM_RUNS=3
LLM_TEMPERATURE=DEFAULT
